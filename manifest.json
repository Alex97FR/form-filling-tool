{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "default_locale": "zh_CN",
  "version": "0.2.14",
  "minimum_chrome_version": "102",
  "key": "",
  "description": "__MSG_extensionDescription__",
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "permissions": ["storage", "clipboardRead", "clipboardWrite", "identity", "alarms"],
  "host_permissions": ["https://docs.google.com/spreadsheets/*", "https://sheets.googleapis.com/*", "https://generativelanguage.googleapis.com/*", "https://openrouter.ai/*", "https://api.openai.com/*"],
  "oauth2": {
    "client_id": "357885944577-1rriecqp10u98ogkqi9p1h71a25mco3o.apps.googleusercontent.com",
    "scopes": ["https://www.googleapis.com/auth/spreadsheets"]
  },
  "content_scripts": [
    {
      "matches": ["https://docs.google.com/spreadsheets/*"],
      "js": ["i18n.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": { "service_worker": "background.js" },
  "options_page": "options.html",
  "action": {
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png"
    },
    "default_title": "__MSG_openConsole__"
  }
}
